// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat  = "cjs"
}

model Admin {
  id           String       @id @default(uuid())
  nome         String
  email        String       @unique
  senha        String
  status       String       @default("Ativo")
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?

  @@map("admin") 
}

model Paciente {
  id             Int          @id @default(autoincrement())
  nome           String       
  cpf            String       
  idade          Int
  doenca_cronica String      
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?
  prescricoes    Prescricao[]

  @@map("pacientes")
}

model Enfermeiro {
  id            Int          @id @default(autoincrement())
  nome          String       
  cpf           String       
  email         String       
  telefone      String       
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?
  prescricoes   Prescricao[]

  @@map("enfermeiros")
}

model Medicamento {
  id             Int          @id @default(autoincrement())
  nome           String       
  descricao      String       
  quantidade     Int
  validade       DateTime     @db.Date
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? 
  prescricoes    Prescricao[]

  @@map("medicamentos")
}

model Prescricao {
  id             Int          @id @default(autoincrement())
  id_paciente    Int
  id_enfermeiro  Int
  id_medicamento Int
  dosagem        Float      
  turno          String       
  data_hora      DateTime     @db.Timestamp() 
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?

  paciente       Paciente     @relation(fields: [id_paciente], references: [id])
  enfermeiro     Enfermeiro   @relation(fields: [id_enfermeiro], references: [id])
  medicamento    Medicamento  @relation(fields: [id_medicamento], references: [id])

  @@map("prescricoes")
}